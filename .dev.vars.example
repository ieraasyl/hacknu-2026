# Cloudflare Workers secrets for local development.
# Loaded by wrangler during `bun run dev`. Copy to .dev.vars and fill in the values.

# ISO 8601 instant when registration closes.
# 1 April 2026 23:59 UTC+5
# After this time, onboarding and team create/join/leave/kick/dissolve are blocked
# REGISTRATION_DEADLINE=2026-04-01T23:59:59+05:00

# local: http://localhost:3000 
# remote: https://hacknu.nuacm.kz
BETTER_AUTH_URL=

BETTER_AUTH_SECRET=
GAS_URL=
GAS_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

ADMIN_EMAILS=
